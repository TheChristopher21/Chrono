# Copy to .env locally. Never commit the real file.
CHRONO_IMAGE_TAG=0.1.0
CHRONO_BACKEND_IMAGE=chrisubuntu1/chrono-backend
CHRONO_FRONTEND_IMAGE=chrisubuntu1/chrono-frontend
MYSQL_IMAGE_TAG=8.0.42
PROMETHEUS_IMAGE_TAG=v3.4.1
GRAFANA_IMAGE_TAG=12.0.2
ALERTMANAGER_IMAGE_TAG=v0.28.1
RESTIC_IMAGE_TAG=0.18.0
NGINX_PROXY_MANAGER_IMAGE=jc21/nginx-proxy-manager@sha256:52b2c59994f3d36acfcf70a1626f29734df0ed8c71bacc0269f78b6f939858bb
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui@sha256:a26effeb220e132482bf7e0560b3404843e7bc40d23051144e062960df8df6b0
OLLAMA_IMAGE=ollama/ollama@sha256:6345fbc18bd73a1e16404be681dbc6fd291a027cab43ed541abe78c4c81051b0
OLLAMA_MODEL=qwen3:8b
LLM_WARMUP_ENABLED=false
CHAT_LLM_THINKING_ENABLED=true
CHAT_LLM_CONTEXT_WINDOW=8192
CHAT_LLM_MAX_OUTPUT_TOKENS=1200

MYSQL_DATABASE=chrono_db
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/chrono_db?sslMode=VERIFY_CA&trustCertificateKeyStoreUrl=file:/run/secrets/mysql-truststore.jks&trustCertificateKeyStoreType=JKS&trustCertificateKeyStorePassword=changeit&fallbackToSystemTrustStore=false&serverTimezone=UTC
MYSQL_USER=chrono_app
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
RESTORE_TEST_ROOT_PASSWORD=replace-with-a-random-restore-password

SPRING_MAIL_HOST=smtp.example.invalid
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=alerts@example.invalid
SPRING_MAIL_PASSWORD=replace-with-a-random-mail-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_FROM=no-reply@chrono-logisch.ch
APP_PUBLIC_BASE_URL=https://chrono-logisch.ch

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=3600000
NFC_AGENT_TOKEN=replace-with-at-least-32-random-characters
REPORT_ICS_FEED_TOKEN=replace-with-at-least-32-random-characters
APP_PMS_DOCUMENT_HMAC_KEY=replace-with-at-least-32-random-characters
APP_PMS_AUDIT_HMAC_KEY=replace-with-at-least-32-random-characters
APP_SECURITY_ALLOWED_ORIGINS=https://chrono-logisch.ch,https://www.chrono-logisch.ch

APP_DEMO_LOGIN_ENABLED=false
APP_DEMO_LOGIN_ALLOW_PRODUCTION=false
APP_PMS_TEST_ACCOUNT_ENABLED=false
APP_PMS_DEMO_DATA_ENABLED=false
APP_INITIALIZE_ADMIN=false

APP_PMS_OUTBOX_ENABLED=true
APP_PMS_OUTBOX_INTERVAL_MS=10000
APP_PMS_OUTBOX_MAX_ATTEMPTS=8
APP_PMS_OUTBOX_INITIAL_BACKOFF=PT30S
APP_PMS_OUTBOX_LOCK_TIMEOUT=PT10M
APP_PMS_MONITORING_PENDING_WARNING_AGE=PT15M
APP_PMS_ALERTS_ENABLED=true
APP_PMS_ALERTS_INTERVAL_MS=300000
APP_PMS_ALERTS_INITIAL_DELAY_MS=60000
APP_PMS_ALERT_EMAIL=
APP_PMS_WEBHOOK_ALLOWED_CLOCK_SKEW=PT5M
APP_PMS_BOOKING_VERIFICATION_TTL=PT15M
APP_PMS_PUBLIC_BOOKING_MAX_STAY_NIGHTS=30

# Generic signed outbound provider gateway. Keep disabled until an HTTPS
# endpoint and a strong shared secret have been issued by the provider.
APP_PMS_PROVIDER_GATEWAY_ENABLED=false
APP_PMS_PROVIDER_GATEWAY_ENDPOINT=
APP_PMS_PROVIDER_GATEWAY_SECRET=
APP_PMS_PROVIDER_GATEWAY_TIMEOUT=PT10S
APP_PMS_PAYMENTS_SIMULATED_ENABLED=false
APP_PMS_PAYMENTS_STRIPE_ENABLED=false

# Optional PMS payment reconciliation and hotel-opt-in deposit links.
# Use the signing secret for /api/public/pms/webhooks/stripe, not an API key.
APP_PMS_PAYMENTS_STRIPE_WEBHOOK_SECRET=
APP_PMS_PAYMENTS_AUTOMATION_ENABLED=false
APP_PMS_PAYMENTS_AUTOMATION_INTERVAL_MS=60000
APP_PMS_PAYMENTS_AUTOMATION_INITIAL_DELAY_MS=30000

# Concrete Beds24 adapter. Hotel settings store an env:... token reference.
# Add that referenced variable separately; never enter a token in the browser.
APP_PMS_BEDS24_WORKER_ENABLED=false
APP_PMS_BEDS24_BASE_URL=https://beds24.com/api/v2/
APP_PMS_BEDS24_WORKER_INTERVAL_MS=30000
APP_PMS_BEDS24_WORKER_INITIAL_DELAY_MS=30000

# Queuing and SMTP delivery are distinct. Both also require hotel-level opt-in.
APP_PMS_BILLING_SCHEDULER_ENABLED=false
APP_PMS_BILLING_SCHEDULER_INTERVAL_MS=300000
APP_PMS_DELIVERY_WORKER_ENABLED=false
APP_PMS_DELIVERY_WORKER_INTERVAL_MS=30000

# Profile/contract documents: 25 MiB/file, 10 GiB/tenant, 5000 versions per company profile.
PMS_DOCUMENT_MAX_FILE_BYTES=26214400
PMS_DOCUMENT_TENANT_QUOTA_BYTES=10737418240
PMS_DOCUMENT_ORGANIZATION_LIMIT=5000
APP_UPLOAD_MAX_FILE_SIZE=32MB
APP_UPLOAD_MAX_REQUEST_SIZE=34MB
# Empty stores blobs in MySQL. Do not set without a private persistent shared
# volume and a coordinated DB+blob backup/restore process. See docs/operations/PMS_RUNTIME_CONFIGURATION.md.
PMS_DOCUMENT_STORAGE_ROOT=

# Native backend backups stay disabled in the distroless app container.
# The dedicated mysql-backup service owns database backups.
APP_BACKUP_ENABLED=false
APP_BACKUP_MONITORING_ENABLED=true
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_MINUTES=1560
RESTORE_MINIMUM_TABLES=20
RESTORE_MINIMUM_PMS_TABLES=41
RESTORE_EXPECTED_FLYWAY_VERSION=auto
APP_BACKUP_RESTORE_EXTERNAL_ENABLED=true
APP_BACKUP_RESTORE_EVIDENCE_DIR=/restore-evidence

# Optional encrypted off-site backup profile (restic).
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
OFFSITE_BACKUP_INTERVAL_SECONDS=86400
OFFSITE_BACKUP_RETENTION_DAYS=90

GRAFANA_ADMIN_USER=chrono-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-grafana-password
ALERT_EMAIL_TO=operations@chrono-logisch.ch

STRIPE_SECRET_KEY=
