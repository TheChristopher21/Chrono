{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "chrono-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"chrono-backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"chrono-backend\"}[5m])), 0.001)",
          "legendFormat": "5xx rate",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "chrono-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"chrono-backend\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"chrono-backend\"}[5m])), 0.001)",
          "legendFormat": "average",
          "refId": "A"
        }
      ],
      "title": "HTTP response time",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "chrono-prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"chrono-backend\",area=\"heap\"})",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{job=\"chrono-backend\",area=\"heap\"})",
          "legendFormat": "max",
          "refId": "B"
        }
      ],
      "title": "JVM heap",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["chrono", "production"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Chrono Production Overview",
  "uid": "chrono-production-overview",
  "version": 1
